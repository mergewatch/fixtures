BRANCH=fixture/68-org-custom-agents
TITLE=feat: add default retry policy for outbound calls
TAGS=config,agents,org-agents,correctness
MODE=pr
BODY=Adds a shared retry policy with per-caller overrides, plus a review-config tweak to keep TODO chatter low-noise.
DRAFT=false
# NEEDS_HUMAN_STEP, not MANUAL_ONLY: the PR is still opened and reviewed
# normally, and the human part is the org-agent prerequisite plus the
# advisory->blocking toggle in POST_OPEN_HINT.
#
# It leaves the AUTOMATED set because PREREQ_CHECK reads DynamoDB and the
# E2E gate job has no AWS credentials, so the prerequisite is unsatisfiable
# there by construction (mergewatch.ai#510, fixtures#1550). It had been
# selected on every gate run and skipped on every gate run, which made the
# graded total read 49 while 48 was the number that could ever pass.
NEEDS_HUMAN_STEP=true
PREREQ_CHECK=scripts/seed-org-agent.sh --verify
POST_OPEN_HINT=Toggle the org agent advisory → blocking in Settings → Custom Agents, then re-review with '@mergewatch review' to compare verdicts.
